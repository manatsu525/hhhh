<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#1F7A6D</item>
        <item name="android:colorPrimaryDark">#185F55</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:actionModeBackground">@color/accent_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="DialogLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
